# Copy to .env (git-ignored) and fill in. Never commit real values.

# Your WRDS username (required).
WRDS_USERNAME=

# Password: preferred route is ~/.pgpass. Run this once; it prompts for the
# password and offers to save it (answer y):
#   python -m src.wrds_conn
# If you cannot use ~/.pgpass, libpq also reads PGPASSWORD from the environment.
# PGPASSWORD=
